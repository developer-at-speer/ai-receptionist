# Copy to .env and fill in. Never commit .env.

PORT=3000
# Public origin Twilio and ElevenLabs can reach. No trailing slash.
APP_BASE_URL=http://127.0.0.1:3000

# SQLite file. Use file::memory: only for local experiments.
DATABASE_URL=file:./data/receptionist.db

# true uses the mock scheduler. Bookings are synthetic and are not Juno appointments.
DEMO_MODE=true

# Bearer secret for the book_appointment webhook. At least 16 characters.
# Put this in the ElevenLabs tool header, never in the agent prompt.
BOOKING_WEBHOOK_SECRET=

# Shared secret from the ElevenLabs post-call webhook configuration.
ELEVENLABS_WEBHOOK_SECRET=

# 32-byte key, base64. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RECIPIENT_DATA_KEY=

# Resend. EMAIL_FROM must be a verified sender on your domain.
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=mathew@speer.io

# Twilio. Booking SMS is sent From this number. Leave the ElevenLabs inbound SMS webhook unchanged.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+12622394630
# Optional. Booking confirmations use TWILIO_PHONE_NUMBER, not a messaging service.
TWILIO_MESSAGING_SERVICE_SID=

# Synthetic patient used only in demo mode. SMS is sent only to this authorized number.
# Caller ID is never copied into this field.
DEMO_PATIENT_REFERENCE=demo-patient-001
DEMO_PATIENT_DOB=1980-01-15
DEMO_AUTHORIZED_SMS_E164=

# Must be the string true before Resend or Twilio are contacted.
ALLOW_LIVE_SENDS=false

# Optional later Juno connection. Leaving these empty does not create Juno appointments.
JUNO_BASE_URL=
JUNO_API_TOKEN=

PHYSICIAN_NAME=Dr. Shah
CLINIC_NAME=Dr. Shah's Family Practice
CLINIC_TIMEZONE=America/Toronto

# Petal Answers board. Leave blank to skip card upload.
# PETAL_CLINIC_NAME must match a clinic name in Petal exactly.
PETAL_API_URL=http://127.0.0.1:41741
PETAL_BOOKING_SECRET=
PETAL_CLINIC_NAME=Harbourview Family Practice
NOTIFICATION_MAX_ATTEMPTS=5
WORKER_INTERVAL_MS=5000
